# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bustrack

# JWT signing secret (use a long random string in production)
JWT_SECRET=your-jwt-secret-here

# Separate refresh-token secret (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# Session timing (seconds). Access token default: 8 hours. Refresh token default: 30 days.
# ACCESS_TOKEN_MAX_AGE_SECONDS=28800
# REFRESH_TOKEN_MAX_AGE_SECONDS=2592000

# Cookie domain for production (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# AES-256-GCM key for encrypting TOTP secrets at rest (generate: openssl rand -hex 32)
TOTP_ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Redis URL for shared cache (reports, school-fee summaries)
REDIS_URL=redis://localhost:6379

# Node environment
NODE_ENV=development

# Razorpay payment gateway (test keys from Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Optional: callback URL for UPI payment links
# RAZORPAY_CALLBACK_URL=https://yourdomain.com/payments/callback
