# Frontend (local)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Backend
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-different-from-jwt-secret
REDIS_URL=redis://localhost:6379
TOTP_ENCRYPTION_KEY=64-char-hex-32-byte-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NODE_ENV=development
COOKIE_SECURE=false
OTP_DEBUG=true

# SMS — MSG91 only (required for real OTP delivery).
# Create Authkey + OTP template in https://control.msg91.com — template must include ##OTP## (variable OTP).
# Local without MSG91: SMS_PROVIDER=console
# SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=EDUNEX

# CORS — browser origins only (comma-separated). Native mobile app does not use CORS.
FRONTEND_URL=http://localhost:3000

# --- Oracle VM / docker-compose.dev-nginx.yml (edunex.taaksha.com) ---
# DOCKERHUB_USERNAME=takshaproduct
# IMAGE_TAG=git-sha-here
# FRONTEND_URL=https://edunex.taaksha.com
# NEXT_PUBLIC_BACKEND_URL=https://edunex.taaksha.com
# COOKIE_SECURE=true
# OTP_DEBUG=true   # shows Dev OTP on parent login; set false when MSG91 SMS is live
# REDIS_URL=redis://redis:6379
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=EDUNEX


# Traccar (GPS tracking)
# Local compose: http://localhost:8082 (or http://traccar:8082 inside docker)
# Staging (docker-compose.dev-nginx.yml): http://traccar:8082
TRACCAR_URL=http://localhost:8082
# Use ONE of: TRACCAR_TOKEN, or TRACCAR_USER + TRACCAR_PASSWORD (a Traccar admin account)
TRACCAR_TOKEN=
TRACCAR_USER=
TRACCAR_PASSWORD=
# Shared secret Traccar must send to the webhook (required in production)
TRACCAR_WEBHOOK_SECRET=
#
# Traccar Client (phone app) on staging/prod — use HTTPS via nginx (no public :5055):
#   Server URL = https://edunex.taaksha.com/osmand
# Hardware trackers with their own protocol still need their own host port (e.g. 5027).

# Production only: parent domain shared by frontend and API (e.g. .school.com) so the login
# cookie reaches the API directly (needed for the live-tracking socket).
COOKIE_DOMAIN=
# Keep raw Traccar payloads in position logs (debugging only; they are bulky).
GPS_STORE_RAW_PAYLOAD=false
