# Server-side backend URL for Next.js rewrites and edge middleware.
# Use the full URL including https:// in production (Vercel env vars).
BACKEND_URL=http://localhost:5000

# Client-side backend URL (WebSocket / direct API if needed).
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Do not set NEXT_PUBLIC_API_URL — cookies must stay on the frontend origin.
